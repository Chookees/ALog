<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverlet settings for the S4 coverage gate.
  Include only the two shipped assemblies. Generated code and explicit
  exclusions are omitted here; the comment above each exclusion is checked
  separately by eng/coverage-gate.py.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ALog]*,[ALog.Extensions.Logging]*</Include>
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCode,CompilerGenerated</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
