{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ALog": {
    "MinimumLevel": "Info",
    "AsyncEnabled": true,
    "BackgroundQueueEnabled": false,
    "Formatter": "plain",
    "Enrichers": [ "MachineName", "ThreadId", "ProcessId", "Activity" ],
    "Console": {
      "Enabled": true,
      "UseColors": true
    },
    "File": {
      "Enabled": true,
      "Path": "logs/aspnet-sample.log",
      "MaxFileSizeInBytes": 1048576
    }
  },
  "AllowedHosts": "*"
}
