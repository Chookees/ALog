<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BB-09 coverage-metadata reader.
    This project is intentionally outside ALog.sln and is not packed.
    eng/coverage-exception-check.py runs the built assembly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>CoverageMetadata</AssemblyName>
    <RootNamespace>CoverageMetadata</RootNamespace>
  </PropertyGroup>
</Project>
