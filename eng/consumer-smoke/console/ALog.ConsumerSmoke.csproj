<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Not part of ALog.sln. eng/consumer-smoke.sh packs the libraries and restores
      this project from that local feed. Referencing the library project would hide the pack path.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ALog.Extensions.Logging" Version="0.2.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
