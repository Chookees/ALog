<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Full zip smoke consumer. Not in ALog.sln.
    References ALog and ALog.Extensions.Logging from an unpacked Full zip (HintPath, Private=true).
    Microsoft.Extensions.* compile refs also come from the zip. Set ZipDir to the unpacked folder.
    The run script copies the remaining zip DLLs (SqlClient, AWS, satellites) beside the output.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FullSmoke</AssemblyName>
    <RootNamespace>FullSmoke</RootNamespace>
    <ZipDir Condition="'$(ZipDir)' == ''">..</ZipDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ALog">
      <HintPath>$(ZipDir)/ALog.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ALog.Extensions.Logging">
      <HintPath>$(ZipDir)/ALog.Extensions.Logging.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(ZipDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging">
      <HintPath>$(ZipDir)/Microsoft.Extensions.Logging.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>$(ZipDir)/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection">
      <HintPath>$(ZipDir)/Microsoft.Extensions.DependencyInjection.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Options">
      <HintPath>$(ZipDir)/Microsoft.Extensions.Options.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Primitives">
      <HintPath>$(ZipDir)/Microsoft.Extensions.Primitives.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Configuration.Abstractions">
      <HintPath>$(ZipDir)/Microsoft.Extensions.Configuration.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Data.SqlClient">
      <HintPath>$(ZipDir)/Microsoft.Data.SqlClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
