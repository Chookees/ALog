<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Throwaway publish host for Full zip staging. Not in ALog.sln.
    ProjectReferences pull ALog and ALog.Extensions.Logging so RID publish
    lays out the real SqlClient graph at the output root.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>ReleaseZipHost</AssemblyName>
    <RootNamespace>ReleaseZipHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ALog\ALog.csproj" />
    <ProjectReference Include="..\..\..\ALog.Extensions.Logging\ALog.Extensions.Logging.csproj" />
  </ItemGroup>
</Project>
