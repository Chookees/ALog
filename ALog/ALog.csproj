<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ALog</PackageId>
    <Version>0.2.1</Version>
    <PackageReleaseNotes>0.2.1: throwing filters drop the event; non-KVP scopes are kept; level gate before work; factory activity scopes are captured at emit; SelfLog.Enable/Disable and LogContext.Push/PushScope.</PackageReleaseNotes>
    <Title>ALog</Title>
    <Authors>Artur Zubert</Authors>
    <Description>ALog is a powerful and extensible logging framework built for .NET 10+.
It is designed to be simple to use, highly configurable, and ready for modern development across platforms including Windows, Linux, and iOS.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Chookees/ALog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Chookees/ALog</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>logging;dotnet;logger;structured-logging</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ALog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.7.509.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <!-- System.Security.Cryptography.Pkcs 10.0.13: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 (High/Moderate), transitiv über Microsoft.Data.SqlClient 6.0.2. Entfernen, sobald SqlClient eine Version mit Pkcs >= 10.0.13 mitbringt. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
